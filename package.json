{
  "name": "pasta",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server/src --watch-path=src/shared server/src/index.ts",
    "start:server": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test server/src/__tests__/scanner.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tanstack/react-query": "^5.105.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
